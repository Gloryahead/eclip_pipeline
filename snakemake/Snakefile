# =============================================================================
# Snakefile — scATAC-seq pipeline (Snakemake alternative to Nextflow)
#
# This mirrors the Nextflow pipeline exactly but uses Snakemake syntax.
# Use this if your team/HPC already uses Snakemake.
#
# Run on HPC (SLURM):
#   snakemake --snakefile /home/u11/maarowosegbe/scATAC-seq_pipeline/snakemake/Snakefile \
#             --configfile /home/u11/maarowosegbe/scATAC-seq_pipeline/snakemake/config.yaml \
#             --executor slurm \
#             --default-resources slurm_account=haining slurm_partition=standard \
#             --jobs 20 \
#             --use-apptainer \
#             --apptainer-args "--bind /xdisk:/xdisk --bind /home:/home" \
#             --rerun-incomplete \
#             -p
# =============================================================================

configfile: "config.yaml"

SAMPLES    = list(config["samples"].keys())
OUTDIR     = config["outdir"]
PIPE_DIR   = config["pipeline_dir"]
R_SIF      = config["r_signac_sif"]

# ── Target rule: all final outputs ───────────────────────────────────────────
rule all:
    input:
        f"{OUTDIR}/06_annotation/atac_annotated.rds",
        f"{OUTDIR}/06_annotation/cluster_annotation_combined.csv",
        f"{OUTDIR}/06_annotation/motif_enrichment.csv"

# ── Stage 1a: Download FASTQs from SRA ───────────────────────────────────────
rule sra_download:
    output:
        directory("{outdir}/01_raw_fastqs/{sample}/{sample}_raw")
    params:
        srr = lambda w: config["samples"][w.sample]["srr"]
    threads: 8
    resources:
        mem_mb  = 16000,
        runtime = 720,   # 12 h in minutes
        slurm_extra = "--partition=standard"
    container: "docker://quay.io/biocontainers/sra-tools:3.1.1--h9f5acd7_0"
    shell:
        """
        mkdir -p {output}
        prefetch --max-size 100G --output-directory . {params.srr}
        fasterq-dump --split-files --include-technical \
            --threads {threads} --outdir {output} \
            {params.srr}/{params.srr}.sra
        pigz -p {threads} {output}/*.fastq
        """

# ── Stage 1b: Detect read lengths and rename to Cell Ranger format ───────────
rule rename_fastqs:
    input:
        raw_dir = "{outdir}/01_raw_fastqs/{sample}/{sample}_raw"
    output:
        directory("{outdir}/01_raw_fastqs/{sample}/{sample}_fastqs")
    params:
        srr = lambda w: config["samples"][w.sample]["srr"]
    threads: 1
    resources:
        mem_mb = 4000, runtime = 30
    container: "docker://quay.io/biocontainers/pigz:2.8"
    script:
        f"{PIPE_DIR}/scripts/bash/rename_fastqs_snakemake.py"

# ── Stage 1c: Cell Ranger ATAC alignment ─────────────────────────────────────
rule cellranger_atac:
    input:
        fastq_dir = "{outdir}/01_raw_fastqs/{sample}/{sample}_fastqs",
        reference = config["cellranger_ref"]
    output:
        outs_dir  = directory("{outdir}/02_cellranger/{sample}/outs"),
        fragments = "{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz"
    params:
        cr_bin    = config["cellranger_atac_path"],
        sample    = "{sample}"
    threads: 16
    resources:
        mem_mb  = 98304,   # 96 GB
        runtime = 1440,    # 24 h
        slurm_extra = "--partition=standard"
    # No container — Cell Ranger ATAC is proprietary; runs from installed binary
    shell:
        """
        {params.cr_bin} count \
            --id={params.sample} \
            --reference={input.reference} \
            --fastqs={input.fastq_dir} \
            --sample={params.sample} \
            --localcores={threads} \
            --localmem=90
        cp -r {params.sample}/outs {wildcards.outdir}/02_cellranger/{params.sample}/
        """

# ── Stage 1d: Tabix-index fragments file ─────────────────────────────────────
rule tabix_index:
    input:
        "{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz"
    output:
        "{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz.tbi"
    threads: 2
    resources:
        mem_mb = 8000, runtime = 60
    container: "docker://quay.io/biocontainers/htslib:1.21--h5efdd21_0"
    shell:
        "tabix -p bed {input}"

# ── Stage 1e: MACS3 peak calling ─────────────────────────────────────────────
rule macs3_callpeak:
    input:
        fragments = "{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz"
    output:
        narrowpeak = "{outdir}/03_macs3/{sample}/{sample}_peaks.narrowPeak"
    params:
        outdir = "{outdir}/03_macs3/{sample}",
        name   = "{sample}"
    threads: 4
    resources:
        mem_mb = 16000, runtime = 120
    container: "docker://quay.io/biocontainers/macs3:3.0.2--py312h66b675f_0"
    shell:
        """
        macs3 callpeak \
            -f FRAG \
            -t {input.fragments} \
            -g hs \
            -n {params.name} \
            --outdir {params.outdir} \
            --keep-dup all \
            -q 0.01
        """

# ── Stage 2: Per-sample Signac QC ────────────────────────────────────────────
rule signac_qc:
    input:
        cr_outs    = "{outdir}/02_cellranger/{sample}/outs",
        frag_index = "{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz.tbi",
        blacklist  = config["blacklist_bed"]
    output:
        qc_rds = "{outdir}/04_qc/{sample}/{sample}_qc.rds"
    params:
        sample_id   = "{sample}",
        ensdb_cache = config["ensdb_cache"],
        min_frags   = config["min_fragments"],
        max_frags   = config["max_fragments"],
        min_tss     = config["min_tss"],
        min_frip    = config["min_frip"],
        max_ns      = config["max_nucleosome"],
        max_bl      = config["max_blacklist_ratio"],
        amulet_q    = config["amulet_qvalue"],
        outdir      = "{outdir}/04_qc/{sample}"
    threads: 8
    resources:
        mem_mb = 65536, runtime = 480
    container: R_SIF
    shell:
        """
        mkdir -p {params.outdir}/plots
        Rscript {PIPE_DIR}/scripts/R/01_signac_qc.R \
            --sample_id      {params.sample_id} \
            --cr_outs        {input.cr_outs} \
            --fragments      {input.cr_outs}/fragments.tsv.gz \
            --frag_index     {input.frag_index} \
            --blacklist_bed  {input.blacklist} \
            --ensdb_cache    {params.ensdb_cache} \
            --min_fragments  {params.min_frags} \
            --max_fragments  {params.max_frags} \
            --min_tss        {params.min_tss} \
            --min_frip       {params.min_frip} \
            --max_nucleosome {params.max_ns} \
            --max_bl_ratio   {params.max_bl} \
            --amulet_q       {params.amulet_q} \
            --outdir         {params.outdir} \
            --plot_dir       {params.outdir}/plots
        """

# ── Stage 3a: Consensus peaks + requantification ─────────────────────────────
rule consensus_peaks:
    input:
        qc_rds_list    = expand("{outdir}/04_qc/{sample}/{sample}_qc.rds",
                                outdir=OUTDIR, sample=SAMPLES),
        peak_bed_list  = expand("{outdir}/03_macs3/{sample}/{sample}_peaks.narrowPeak",
                                outdir=OUTDIR, sample=SAMPLES),
        frag_list      = expand("{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz",
                                outdir=OUTDIR, sample=SAMPLES),
        frag_idx_list  = expand("{outdir}/02_cellranger/{sample}/outs/fragments.tsv.gz.tbi",
                                outdir=OUTDIR, sample=SAMPLES),
        blacklist      = config["blacklist_bed"]
    output:
        merged_rds  = f"{OUTDIR}/05_integration/atac_merged_consensus.rds",
        peaks_rds   = f"{OUTDIR}/05_integration/consensus_peaks.rds"
    params:
        peak_min_w  = config["peak_min_width"],
        peak_max_w  = config["peak_max_width"],
        min_cells   = config["min_cells_per_peak"],
        outdir      = f"{OUTDIR}/05_integration"
    threads: 8
    resources:
        mem_mb = 65536, runtime = 480
    container: R_SIF
    run:
        qc_str   = ",".join(input.qc_rds_list)
        peak_str = ",".join(input.peak_bed_list)
        frag_str = ",".join(input.frag_list)
        fidx_str = ",".join(input.frag_idx_list)
        shell(f"""
        mkdir -p {params.outdir}/plots
        Rscript {PIPE_DIR}/scripts/R/02_consensus_peaks.R \
            --qc_rds_list   '{qc_str}' \
            --peak_bed_list '{peak_str}' \
            --frag_list     '{frag_str}' \
            --frag_idx_list '{fidx_str}' \
            --blacklist_bed {input.blacklist} \
            --peak_min_width {params.peak_min_w} \
            --peak_max_width {params.peak_max_w} \
            --min_cells      {params.min_cells} \
            --outdir         {params.outdir} \
            --plot_dir       {params.outdir}/plots
        """)

# ── Stage 3b: Integration and clustering ─────────────────────────────────────
rule integration:
    input:
        merged_rds = f"{OUTDIR}/05_integration/atac_merged_consensus.rds"
    output:
        clustered_rds = f"{OUTDIR}/05_integration/atac_integrated_clustered.rds",
        metadata_csv  = f"{OUTDIR}/05_integration/integrated_cell_metadata.csv"
    params:
        lsi_dims    = config["lsi_dims"],
        harmony_dims = config["harmony_dims"],
        resolutions = config["cluster_resolution"],
        min_cells   = config["min_cells_per_peak"],
        outdir      = f"{OUTDIR}/05_integration"
    threads: 16
    resources:
        mem_mb = 131072, runtime = 720  # 128 GB, 12 h
    container: R_SIF
    shell:
        """
        Rscript {PIPE_DIR}/scripts/R/03_integration_clustering.R \
            --merged_rds  {input.merged_rds} \
            --lsi_dims    '{params.lsi_dims}' \
            --harmony_dims '{params.harmony_dims}' \
            --resolutions '{params.resolutions}' \
            --min_cells   {params.min_cells} \
            --outdir      {params.outdir} \
            --plot_dir    {params.outdir}/plots
        """

# ── Stage 4: Cell type annotation ────────────────────────────────────────────
rule cell_type_annotation:
    input:
        clustered_rds = f"{OUTDIR}/05_integration/atac_integrated_clustered.rds",
        rna_ref_rds   = config["rna_ref_rds"]
    output:
        annotated_rds   = f"{OUTDIR}/06_annotation/atac_annotated.rds",
        combined_labels = f"{OUTDIR}/06_annotation/cluster_annotation_combined.csv",
        motif_csv       = f"{OUTDIR}/06_annotation/motif_enrichment.csv"
    params:
        harmony_dims  = config["harmony_dims"],
        gene_upstream = config["gene_activity_upstream"],
        pred_min      = config["prediction_score_min"],
        marker_fdr    = config["marker_peak_fdr"],
        genome        = config["genome"],
        outdir        = f"{OUTDIR}/06_annotation"
    threads: 8
    resources:
        mem_mb = 65536, runtime = 480
    container: R_SIF
    shell:
        """
        mkdir -p {params.outdir}/plots
        Rscript {PIPE_DIR}/scripts/R/04_cell_type_annotation.R \
            --clustered_rds  {input.clustered_rds} \
            --rna_ref_rds    {input.rna_ref_rds} \
            --harmony_dims   '{params.harmony_dims}' \
            --gene_upstream  {params.gene_upstream} \
            --pred_score_min {params.pred_min} \
            --marker_fdr     {params.marker_fdr} \
            --genome         {params.genome} \
            --outdir         {params.outdir} \
            --plot_dir       {params.outdir}/plots
        """
